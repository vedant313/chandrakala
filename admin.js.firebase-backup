import { auth, db, storage, ADMIN_EMAIL } from './firebase-config.js';
import { onAuthStateChanged, signInWithEmailAndPassword, signOut } from 'https://www.gstatic.com/firebasejs/11.0.0/firebase-auth.js';
import { collection, getDocs, addDoc, updateDoc, deleteDoc, doc, orderBy, query, serverTimestamp, setDoc } from 'https://www.gstatic.com/firebasejs/11.0.0/firebase-firestore.js';
import { ref, uploadBytes, getDownloadURL, deleteObject } from 'https://www.gstatic.com/firebasejs/11.0.0/firebase-storage.js';

const $=s=>document.querySelector(s), $$=s=>[...document.querySelectorAll(s)], money=n=>'₹'+Number(n||0).toLocaleString('en-IN');
let products=[], gallery=[], orders=[], settings={}, active='Dashboard', editing=null;
const cats=['Sarees','Kurtis','Dresses','Kids Wear',"Men's Wear",'School Uniform','New Arrival'];
function toast(m){const t=$('#toast');t.textContent=m;t.classList.add('show');setTimeout(()=>t.classList.remove('show'),2600)}
function login(){document.body.innerHTML=`<div id="toast" class="toast"></div><div class="login-wrap"><div class="login-card"><div class="eyebrow">CHANDRAKALA FASHION</div><h1 style="font:700 42px Georgia,serif;margin:8px 0">Admin portal</h1><p class="muted">Private management area. Customers never see this page.</p><div class="field"><label>Admin email</label><input id="email" value="${ADMIN_EMAIL}"></div><div class="field"><label>Password</label><input id="password" type="password" placeholder="Enter admin password"></div><button class="btn" style="width:100%" id="loginBtn">Sign in securely</button><p class="notice" style="margin-top:15px">Only the Firebase account <b>${ADMIN_EMAIL}</b> is authorized by the security rules.</p></div></div>`;$('#loginBtn').onclick=async()=>{try{await signInWithEmailAndPassword(auth,$('#email').value,$('#password').value)}catch(e){toast(e.message.replace('Firebase: ','').split(' (auth')[0])}}}
async function load(){try{products=(await getDocs(collection(db,'products'))).docs.map(d=>({id:d.id,...d.data()})).sort((a,b)=>(a.sortOrder??99999)-(b.sortOrder??99999))}catch{products=[]}try{gallery=(await getDocs(collection(db,'gallery'))).docs.map(d=>({id:d.id,...d.data()})).sort((a,b)=>(a.sortOrder??99999)-(b.sortOrder??99999))}catch{gallery=[]}try{orders=(await getDocs(collection(db,'orders'))).docs.map(d=>({id:d.id,...d.data()})).sort((a,b)=>{const aa=a.createdAt?.seconds||0,bb=b.createdAt?.seconds||0;return bb-aa})}catch{orders=[]}try{const s=await getDocs(collection(db,'settings'));settings=s.docs.find(d=>d.id==='store')?.data()||{}}catch{settings={}}render()}
function render(){document.body.innerHTML=`<div class="admin-shell"><header class="admin-top"><div><b>Chandrakala Fashion</b><span style="opacity:.6;margin-left:10px">Admin</span></div><div style="display:flex;gap:8px"><a class="btn light" href="index.html">View Store</a><button class="btn gold" id="logout">Sign out</button></div></header><div class="admin-main"><aside class="admin-side">${['Dashboard','Products','Gallery','Orders','Payments','Settings'].map(t=>`<button class="admin-tab ${active===t?'active':''}" data-tab="${t}">${t}</button>`).join('')}</aside><main class="admin-content"><div id="panel"></div></main></div></div><div id="toast" class="toast"></div>`;$('#logout').onclick=()=>signOut(auth);$$('[data-tab]').forEach(b=>b.onclick=()=>{active=b.dataset.tab;render()});panel();}
function panel(){const p=$('#panel');if(active==='Dashboard')p.innerHTML=dashboard();if(active==='Products')p.innerHTML=productsPanel();if(active==='Gallery')p.innerHTML=galleryPanel();if(active==='Orders')p.innerHTML=ordersPanel();if(active==='Payments')p.innerHTML=paymentsPanel();if(active==='Settings')p.innerHTML=settingsPanel();bindPanel()}
function dashboard(){const revenue=orders.filter(o=>o.status==='Paid'||o.status==='Completed').reduce((s,o)=>s+Number(o.total||0),0);return `<div class="eyebrow">CONTROL CENTRE</div><h1 style="font:700 46px Georgia,serif;margin:8px 0">Store dashboard</h1><p class="muted">Everything important is managed from here.</p><div class="stat-grid"><div class="stat-card"><span class="muted">Products</span><br><b>${products.length}</b></div><div class="stat-card"><span class="muted">Gallery photos</span><br><b>${gallery.length}</b></div><div class="stat-card"><span class="muted">Orders</span><br><b>${orders.length}</b></div><div class="stat-card"><span class="muted">Paid revenue</span><br><b>${money(revenue)}</b></div></div><div class="admin-card"><h2>Admin checklist</h2><p class="muted">✓ Product add/edit/delete & image upload<br>✓ Gallery upload/delete/reorder<br>✓ Order status management<br>✓ Razorpay/UPI/COD configuration<br>✓ Store contact/settings</p></div>`}
function productsPanel(){return `<div style="display:flex;justify-content:space-between;align-items:center;gap:10px"><div><div class="eyebrow">CATALOGUE</div><h1 style="font:700 40px Georgia,serif">Products</h1></div><button class="btn" id="newProduct">+ Add product</button></div><div class="admin-card">${products.length?`<table class="admin-table"><thead><tr><th>Image</th><th>Product</th><th>Category</th><th>Price</th><th>Stock</th><th>Actions</th></tr></thead><tbody>${products.map(p=>`<tr><td><img class="admin-thumb" src="${p.image||''}"></td><td><b>${p.name}</b></td><td>${p.category||''}</td><td>${money(p.price)}</td><td>${p.stock||''}</td><td><div class="row-actions"><button class="small-btn" data-edit="${p.id}">Edit</button><button class="small-btn danger" data-del="${p.id}">Delete</button></div></td></tr>`).join('')}</tbody></table>`:'<div class="notice">No products yet. Add your first product.</div>'}</div>`}
function productForm(p={name:'',category:cats[0],price:'',stock:'In Stock',image:''}){openModal(`<h2>${editing?'Edit':'Add'} product</h2><div class="field"><label>Product name</label><input id="pn" value="${esc(p.name)}"></div><div class="form-grid"><div class="field"><label>Category</label><select id="pc">${cats.map(c=>`<option ${c===p.category?'selected':''}>${c}</option>`).join('')}</select></div><div class="field"><label>Price (INR)</label><input id="pp" type="number" value="${p.price||''}"></div></div><div class="field"><label>Stock label</label><input id="ps" value="${esc(p.stock||'In Stock')}"></div><div class="field"><label>Product image</label><input id="pi" value="${esc(p.image||'')}" placeholder="Image URL or upload below"><input id="pif" type="file" accept="image/*"></div><div class="actions"><button class="btn" id="saveP">Save product</button><button class="btn light" id="cancelM">Cancel</button></div>`);$('#cancelM').onclick=closeModal;$('#saveP').onclick=async()=>{try{let image=$('#pi').value.trim();const file=$('#pif').files[0];if(file){image=await uploadFile(file,'products')}if(!image)throw Error('Please add an image URL or upload an image.');const data={name:$('#pn').value.trim(),category:$('#pc').value,price:Number($('#pp').value),stock:$('#ps').value.trim(),image,updatedAt:serverTimestamp()};if(editing)await updateDoc(doc(db,'products',editing),data);else await addDoc(collection(db,'products'),{...data,sortOrder:products.length,createdAt:serverTimestamp()});closeModal();await load();toast('Product saved')}catch(e){toast(e.message)}}}
function galleryPanel(){return `<div style="display:flex;justify-content:space-between;align-items:center"><div><div class="eyebrow">VISUAL CONTENT</div><h1 style="font:700 40px Georgia,serif">Gallery</h1></div><button class="btn" id="uploadGallery">+ Upload photos</button></div><div class="admin-card"><div class="notice">Drag order controls with ↑ ↓. Delete removes the gallery record and the uploaded Firebase Storage file.</div><div class="gallery-admin" style="margin-top:16px">${gallery.map((g,i)=>`<div class="gallery-admin-item"><img src="${g.image}"><div style="font-size:12px;margin:8px 0"><b>#${i+1}</b></div><div class="row-actions"><button class="small-btn" data-up="${g.id}">↑</button><button class="small-btn" data-down="${g.id}">↓</button><button class="small-btn danger" data-gdel="${g.id}">Delete</button></div></div>`).join('')}</div></div>`}
function ordersPanel(){return `<div class="eyebrow">SALES</div><h1 style="font:700 40px Georgia,serif">Orders</h1><div class="admin-card">${orders.length?`<table class="admin-table"><thead><tr><th>Customer</th><th>Total</th><th>Payment</th><th>Address</th><th>Status</th></tr></thead><tbody>${orders.map(o=>`<tr><td><b>${esc(o.customer||'Customer')}</b><br>${esc(o.phone||'')}</td><td>${money(o.total)}</td><td>${esc(o.payment||'')}</td><td>${esc(o.address||'')}</td><td><select data-status="${o.id}">${['New','Payment Pending','Paid','Packed','Out for Delivery','Completed','Cancelled'].map(s=>`<option ${s===(o.status||'New')?'selected':''}>${s}</option>`).join('')}</select></td></tr>`).join('')}</tbody></table>`:'<div class="notice">No orders yet.</div>'}</div>`}
function paymentsPanel(){return `<div class="eyebrow">CHECKOUT</div><h1 style="font:700 40px Georgia,serif">Payment Gateway</h1><div class="admin-card"><h2>Razorpay</h2><p class="muted">Store only the public Key ID here. Never put the Razorpay secret key in this website or Firestore.</p><div class="field"><label>Enable online payment</label><select id="payEnabled"><option value="false">Disabled</option><option value="true" ${settings.paymentEnabled?'selected':''}>Enabled</option></select></div><div class="field"><label>Razorpay Key ID (public)</label><input id="razorKey" value="${esc(settings.razorpayKeyId||'')}" placeholder="rzp_test_... or rzp_live_..."></div><div class="field"><label>UPI ID (optional fallback / display)</label><input id="upi" value="${esc(settings.upiId||'')}" placeholder="business@upi"></div><button class="btn" id="savePay">Save payment settings</button><div class="notice" style="margin-top:16px"><b>For live Razorpay:</b> you still need a secure server/Firebase Cloud Function that creates Razorpay Orders using your secret key. This frontend is prepared to use the public key but must not receive the secret key.</div></div>`}
function settingsPanel(){return `<div class="eyebrow">STORE PROFILE</div><h1 style="font:700 40px Georgia,serif">Settings</h1><div class="admin-card"><div class="field"><label>Store name</label><input id="storeName" value="${esc(settings.storeName||'Chandrakala Fashion')}"></div><div class="field"><label>Phone</label><input id="storePhone" value="${esc(settings.phone||'+91 93700 17895')}"></div><div class="field"><label>Address</label><textarea id="storeAddress" rows="3">${esc(settings.address||'1500, Agra Rd, Navnath Nager, Dhule, Maharashtra 424001')}</textarea></div><div class="field"><label>WhatsApp number (digits only)</label><input id="wa" value="${esc(settings.whatsapp||'919370017895')}"></div><button class="btn" id="saveSettings">Save store settings</button></div>`}
function bindPanel(){if($('#newProduct'))$('#newProduct').onclick=()=>{editing=null;productForm()};$$('[data-edit]').forEach(b=>b.onclick=()=>{editing=b.dataset.edit;productForm(products.find(p=>p.id===editing))});$$('[data-del]').forEach(b=>b.onclick=()=>deleteProduct(b.dataset.del));if($('#uploadGallery'))$('#uploadGallery').onclick=galleryUpload;$$('[data-gdel]').forEach(b=>b.onclick=()=>deleteGallery(b.dataset.gdel));$$('[data-up]').forEach(b=>b.onclick=()=>moveGallery(b.dataset.up,-1));$$('[data-down]').forEach(b=>b.onclick=()=>moveGallery(b.dataset.down,1));$$('[data-status]').forEach(s=>s.onchange=()=>updateDoc(doc(db,'orders',s.dataset.status),{status:s.value}).then(()=>toast('Order status updated')));if($('#savePay'))$('#savePay').onclick=savePayment;if($('#saveSettings'))$('#saveSettings').onclick=saveSettings}
async function galleryUpload(){openModal(`<h2>Upload gallery photos</h2><p class="muted">Select multiple images. They will be stored in Firebase Storage and ordered automatically.</p><div class="field"><input id="gf" type="file" accept="image/*" multiple></div><button class="btn" id="gup">Upload</button>`);$('#gup').onclick=async()=>{const files=[...$('#gf').files];if(!files.length)return toast('Select at least one image');try{for(const file of files){const image=await uploadFile(file,'gallery');await addDoc(collection(db,'gallery'),{image,storagePath:`gallery/${file.name}`,sortOrder:gallery.length,createdAt:serverTimestamp()});gallery.length++}closeModal();await load();toast('Gallery uploaded')}catch(e){toast(e.message)}}}
async function uploadFile(file,folder){const safe=`${Date.now()}-${Math.random().toString(36).slice(2)}-${file.name.replace(/[^a-zA-Z0-9._-]/g,'_')}`;const r=ref(storage,`${folder}/${safe}`);await uploadBytes(r,file);return getDownloadURL(r)}
async function deleteProduct(id){if(!confirm('Delete this product?'))return;try{await deleteDoc(doc(db,'products',id));await load();toast('Product deleted')}catch(e){toast(e.message)}}
async function deleteGallery(id){if(!confirm('Delete this gallery photo?'))return;try{const g=gallery.find(x=>x.id===id);await deleteDoc(doc(db,'gallery',id));if(g?.storagePath)try{await deleteObject(ref(storage,g.storagePath))}catch{}await load();toast('Gallery photo deleted')}catch(e){toast(e.message)}}
async function moveGallery(id,delta){const i=gallery.findIndex(g=>g.id===id),j=i+delta;if(i<0||j<0||j>=gallery.length)return;const a=gallery[i],b=gallery[j];await updateDoc(doc(db,'gallery',a.id),{sortOrder:b.sortOrder});await updateDoc(doc(db,'gallery',b.id),{sortOrder:a.sortOrder});await load()}
async function savePayment(){settings={...settings,paymentEnabled:$('#payEnabled').value==='true',razorpayKeyId:$('#razorKey').value.trim(),upiId:$('#upi').value.trim()};await setDoc(doc(db,'settings','store'),settings);toast('Payment settings saved')}
async function saveSettings(){settings={...settings,storeName:$('#storeName').value.trim(),phone:$('#storePhone').value.trim(),address:$('#storeAddress').value.trim(),whatsapp:$('#wa').value.trim()};await setDoc(doc(db,'settings','store'),settings);toast('Store settings saved')}
function openModal(html){let m=document.createElement('div');m.id='modal';m.className='modal';m.innerHTML=`<div class="modal-card">${html}</div>`;document.body.appendChild(m)}function closeModal(){$('#modal')?.remove()}function esc(v){return String(v??'').replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;').replaceAll('"','&quot;')}
onAuthStateChanged(auth,u=>{if(!u||u.email!==ADMIN_EMAIL)login();else load()});
